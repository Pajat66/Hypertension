<view class="container">
  <view class="spacer-8"></view>
  <view class="logo-placeholder"></view>
  <view class="page-header">
    <text class="user-name">{{displayName || '姓名'}}</text>
  </view>

  <!-- 退出登录悬浮按钮（患者） -->
  <button class="logout-fab" bindtap="handleLogoutTap" hover-class="logout-fab--hover">退出</button>

  <!-- 大卡片按钮组 -->
  <view class="card-group">
    <view class="card home-card" bindtap="onTapMicBp">
      <view class="card-content">
        <view>
          <text class="title-large">血压录入</text>
          <view class="spacer-8"></view>
          <text class="card-subtitle">说收缩压、舒张压</text>
        </view>
        <image src="/images/icon/麦克风.png" class="card-icon" />
      </view>
    </view>

    <view class="card home-card" bindtap="onTapMicMed">
      <view class="card-content">
        <view>
          <text class="title-large">查用药</text>
          <view class="spacer-8"></view>
          <text class="card-subtitle">查看医生所开药物</text>
        </view>
        <image src="/images/icon/麦克风.png" class="card-icon" />
      </view>
    </view>

    <view class="card home-card" bindtap="onSpeaker">
      <view class="card-content">
        <text class="title-large">听提醒</text>
        <image src="/images/icon/喇叭.png" class="card-icon-speaker"/>
      </view>
    </view>

    <!-- 两个小按钮并排 -->
    <view class="sub-actions">
      <!-- 联系村医留言 -->
      <view class="card sub-card" bindtap="gotoPtChat">
        <image src="/images/icon/留言.png" class="sub-card-icon"/>
        <text class="sub-card-title">联系村医留言</text>
      </view>
      <!-- 血压历史 -->
      <view class="card sub-card" bindtap="gotoBlood">
        <image src="/images/icon/历史.png" class="sub-card-icon"/>
        <text class="sub-card-title">血压历史</text>
      </view>
    </view>
  </view>
</view>
